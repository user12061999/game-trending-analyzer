# Copy this file to .env and fill in your values. .env is git-ignored.

# Google Gemini (AI deconstruct / hybrid lab). Leave empty to use the built-in heuristic engine.
GEMINI_API_KEY=
# Model name used for every Gemini call
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Steam Web API key
STEAM_API_KEY=

# Web server
HOST=127.0.0.1
PORT=8888

# Daily crawl time (24h, local machine time) and countries to crawl
DAILY_CRAWL_HOUR=6
DAILY_CRAWL_MINUTE=0
CRAWL_COUNTRIES=us,vn,kr,jp,global
